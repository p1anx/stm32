{
    "cortex-debug.armToolchainPath.linux": "/usr/bin",
    "cortex-debug.gdbPath.linux": "/usr/local/arm-gnu-toolchain/bin/arm-none-eabi-gdb",
    "cortex-debug.openocdPath": "/usr/bin/openocd",
    "clangd.arguments": [
        "--clang-tidy",
        "--compile-commands-dir=${workspaceFolder}/build/default", //compile_commands.json filePath
        "--function-arg-placeholders=false",// options:true or false
        "--completion-style=detailed",       // 简洁模式，减少显示开销
        "--header-insertion=never",
        "--limit-results=50",               // 限制补全结果数量
        "--pch-storage=memory",               // 磁盘模式，避免内存占用
        "--completion-parse=never",         // 不重新解析，使用缓存
        "-j=8",                              // 更多线程
        "--background-index=false",
    ],

    "C_Cpp.intelliSenseEngine": "default", //disabled, default
    "cortex-debug.armToolchainPath": "/opt/st/stm32cubeclt_1.19.0/GNU-tools-for-STM32/bin",
  // 禁用相对行号（大文件时很消耗性能）
//   "editor.lineNumbers": "on",  // 不使用 "relative"
//  "enditor.semanticHighlighting": false,
    // "outline-map."
}